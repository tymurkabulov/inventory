# Скопируйте в .env и заполните. Пароли — только [A-Za-z0-9] (они идут в URL подключения).
#   openssl rand -hex 24

POSTGRES_PASSWORD=
HORIZON_API_DB_PASSWORD=

# Часовой пояс для бэкапов и дат в интерфейсе
TZ_NAME=Europe/Moscow

# Вход
SESSION_TTL_DAYS=30
INVITE_VALID_HOURS=72
# Ключ шифрования секретов приложения с одноразовыми кодами: openssl rand -hex 24
# Поменяете ключ — всем придётся подключать приложение заново.
APP_SECRET=
# Пароль для шифрования бэкапов: openssl rand -hex 24. Пусто — дампы лежат как есть.
# Храните его отдельно от самих дампов, иначе шифрование бессмысленно.
BACKUP_PASSPHRASE=
# Без HTTPS (локальная проверка) поставьте false, иначе браузер не сохранит cookie
SECURE_COOKIES=true

# Язык по умолчанию для тех, кто не выбирал язык в интерфейсе: uk | en
DEFAULT_LOCALE=uk

# Веб: по умолчанию слушает только localhost:8080 (за Caddy/обратным прокси)
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Домен для профиля tls (Caddy сам получит сертификат)
DOMAIN=
# HTTPS: с tls поднимается Caddy и сам выпускает сертификат на DOMAIN.
# Пусто — только http на HTTP_BIND:HTTP_PORT (локальная проверка).
COMPOSE_PROFILES=tls

BACKUP_AT=03:30
BACKUP_KEEP_DAYS=14
