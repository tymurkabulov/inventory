# Скопируйте в .env и заполните. Пароли — только [A-Za-z0-9] (они идут в URL подключения).
#   openssl rand -hex 24

POSTGRES_PASSWORD=
HORIZON_API_DB_PASSWORD=

# Часовой пояс для бэкапов и дат в интерфейсе
TZ_NAME=Europe/Kyiv

# Вход
SESSION_TTL_DAYS=30
INVITE_VALID_HOURS=72
# Ключ шифрования секретов приложения с одноразовыми кодами: openssl rand -hex 24
# Поменяете ключ — всем придётся подключать приложение заново.
APP_SECRET=
# Пароль для шифрования бэкапов: openssl rand -hex 24. Пусто — дампы лежат как есть.
# Храните его отдельно от самих дампов, иначе шифрование бессмысленно.
BACKUP_PASSPHRASE=
# Без HTTPS (локальная проверка) поставьте false, иначе браузер не сохранит cookie
SECURE_COOKIES=true

# Язык по умолчанию для тех, кто не выбирал язык в интерфейсе: uk | en
DEFAULT_LOCALE=uk

# Веб: по умолчанию слушает только localhost:8080 (за Caddy/обратным прокси)
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Домен для профиля tls (Caddy сам получит сертификат)
DOMAIN=
# HTTPS: с tls поднимается Caddy и сам выпускает сертификат на DOMAIN.
# Пусто — только http на HTTP_BIND:HTTP_PORT (локальная проверка).
COMPOSE_PROFILES=tls

# Сколько обратных прокси стоит перед API. Число обязано совпадать с реальной
# цепочкой:
#   1 — только nginx (COMPOSE_PROFILES пуст либо TLS терминирует что-то своё);
#   2 — профиль tls, то есть Caddy → nginx → api.
# С заниженным числом адресом каждого клиента станет адрес Caddy, и 20 чужих
# ошибок входа в час закроют вход всей роте. С завышенным API поверит адресу,
# который прислал сам клиент, и лимит обойдут подстановкой заголовка.
# С COMPOSE_PROFILES=tls и числом меньше 2 API не стартует.
TRUST_PROXY_HOPS=2

# Лимиты входа. IP-лимит имеет смысл только при верном TRUST_PROXY_HOPS.
LOGIN_FAILS_PER_IP_HOUR=20
LOGIN_FAILS_PER_USER_HOUR=50
SESSION_ROTATE_HOURS=24

BACKUP_AT=03:30
BACKUP_KEEP_DAYS=14
# Heartbeat-ссылка наблюдателя: backup.sh дёргает её после удачного дампа.
# Сутки без сигнала — наблюдатель пишет письмо. Пусто — сигнал не шлётся.
BACKUP_PING_URL=

# Наблюдение. /api/health открыт наружу и отдаёт всем только ok и degraded.
# Версию схемы и счётчики — по заголовку x-horizon-ops с этим значением.
# Пусто — не отдаёт никому. openssl rand -hex 16
OPS_TOKEN=
